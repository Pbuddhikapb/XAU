[Unit]
Description=Binance XAUUSDT Market Intelligence Backend & Web Terminal
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/XAU
EnvironmentFile=/home/ubuntu/XAU/.env
ExecStart=/home/ubuntu/XAU/.venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5

# Security & Sandboxing
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true

# Resource Limits
MemoryMax=2G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
